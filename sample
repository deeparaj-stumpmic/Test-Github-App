@router.post(
    "/add",
    response_model=response.ApiResponse,
    status_code=201,
    summary="Add a user to the enterprise",
)
async def add_user(
    data: request.AddEnterpriseUserRequest,
    admin_ctx: dict = Depends(require_enterprise_context("enterprise_admin")),
):
    db = require_db()
    enterprise_id = admin_ctx["enterprise_id"]
    admin_user = admin_ctx["user"]
    email = data.email.lower().strip()

    try:
        existing = list(
            db.client.collection(USERS_COLLECTION)
            .where("email", "==", email)
            .limit(1)
            .stream()
        )

        if not existing:
            raise HTTPException(status_code=404, detail=f"User '{email}' not found")

        user_doc = existing[0]
        user_data = user_doc.to_dict()

        if user_data.get("enterprise_id") == enterprise_id:
            raise HTTPException(
                status_code=400,
                detail=f"User '{email}' is already a member of this enterprise",
            )
        if user_data.get("enterprise_id"):
            raise HTTPException(
                status_code=400,
                detail=f"User '{email}' is already assigned to another enterprise",
            )

        user_doc.reference.update(
            {
                "enterprise_id": enterprise_id,
                "is_active": True,
                "role": data.role or "enterprise_user",
                "display_name": data.display_name or user_data.get("display_name", ""),
                "updated_at": datetime.now(timezone.utc),
                "updated_by": admin_user.get("uid", ""),
            }
        )

        logger.info(
            f"User {email} added to enterprise {enterprise_id} by admin {admin_user.get('email')}"
        )

        return response.ApiResponse(
            success=True,
            message=f"User '{email}' added to enterprise successfully",
            data=response.UserData(**serialize_doc(user_doc.reference.get())),
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error adding user {email} to enterprise {enterprise_id}: {e}")
        raise HTTPException(status_code=500, detail="Failed to add user to enterprise")


@router.get(
    "/",
    response_model=response.ApiListResponse,
    summary="List all users in the enterprise",
)
async def list_users(
    params: request.ListEnterpriseUserQueryParams = Depends(),
    admin_ctx: dict = Depends(require_enterprise_context("enterprise_admin")),
):
    db = require_db()
    enterprise_id = admin_ctx["enterprise_id"]

    try:
        query = db.client.collection(USERS_COLLECTION)
        query = query.where("enterprise_id", "==", enterprise_id)

        if params.role:
            query = query.where("role", "==", params.role)

        all_docs = list(query.stream())

        if params.is_active is not None:
            all_docs = [
                d
                for d in all_docs
                if d.to_dict().get("is_active", False) == params.is_active
            ]

        if params.created_from or params.created_to:
            all_docs = [
                d
                for d in all_docs
                if matches_date_range(
                    d.to_dict().get("created_at"),
                    params.created_from,
                    params.created_to,
                )
            ]

        if params.search:
            s = params.search.lower().strip()
            all_docs = [
                d
                for d in all_docs
                if (ud := d.to_dict())
                and (
                    s in ud.get("display_name", "").lower()
                    or s in ud.get("email", "").lower()
                )
            ]

        all_docs = exclude_stumpmic_admin_users(all_docs)

        # Batch-fetch product assignments for all enterprise users
        product_map = _build_user_product_map(db, enterprise_id)

        total_count = len(all_docs)
        total_pages = max(1, -(-total_count // params.page_size))

        start = (params.page - 1) * params.page_size
        page_docs = all_docs[start : start + params.page_size]

        users_data = []
        for d in page_docs:
            try:
                user_dict = serialize_doc(d)
                user_dict["product_ids"] = product_map.get(d.id, [])
                users_data.append(response.UserData(**user_dict))
            except Exception as user_err:
                logger.warning(f"Skipping malformed user doc {d.id}: {user_err}")

        return response.ApiListResponse(
            success=True,
            message=f"Found {total_count} user(s) in enterprise",
            data=users_data,
            pagination=response.PaginationMeta(
                page=params.page,
                page_size=params.page_size,
                total_count=total_count,
                total_pages=total_pages,
                has_next=params.page < total_pages,
                has_previous=params.page > 1,
            ),
        )

    except Exception as e:
        logger.error(f"Error listing enterprise users: {e}")
        raise HTTPException(status_code=500, detail="Failed to list enterprise users")


