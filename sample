@router.delete(
    "/{user_id}",
    response_model=response.ApiResponse,
    summary="Remove a user from the enterprise",
)
async def remove_user(
    user_id: str,
    admin_ctx: dict = Depends(require_enterprise_context("enterprise_admin")),
):
    admin_uid = admin_ctx["user"].get("uid", "")

    # ✅ Check self before hitting the DB
    if user_id == admin_uid:
        raise HTTPException(
            status_code=400, detail="Cannot remove yourself from the enterprise"
        )
    db = require_db()
    admin_uid = admin_ctx["user"].get("uid", "")
    enterprise_id = admin_ctx["enterprise_id"]

    if user_id == admin_uid:
        raise HTTPException(
            status_code=400, detail="Cannot remove yourself from the enterprise"
        )

    doc_ref = db.client.collection(USERS_COLLECTION).document(user_id)
    doc = doc_ref.get()

    if not doc.exists or doc.to_dict().get("enterprise_id") != enterprise_id:
        raise HTTPException(status_code=404, detail="User not found in this enterprise")

    doc_ref.update(
        {
            "enterprise_id": None,
            "is_active": False,
            "updated_at": datetime.now(timezone.utc),
            "updated_by": admin_uid,
        }
    )

    # Clean up user_products for this user
    up_docs = list(
        db.client.collection(USER_PRODUCTS_COLLECTION)
        .where("user_id", "==", user_id)
        .where("enterprise_id", "==", enterprise_id)
        .stream()
    )
    for up in up_docs:
        up.reference.delete()

    logger.info(
        f"User {doc.to_dict().get('email')} removed from enterprise {enterprise_id} by admin {admin_ctx['user'].get('email')}"
    )

    return response.ApiResponse(
        success=True,
        message="User removed from enterprise successfully",
        data=response.UserData(**serialize_doc(doc_ref.get())),
    )


@router.post(
    "/{user_id}/integrations",
    response_model=response.ApiResponse,
    status_code=201,
    summary="Assign integration to an enterprise user",
)
async def assign_user_integration(
    user_id: str,
    data: request.AssignUserIntegrationRequest,
    admin_ctx: dict = Depends(require_enterprise_context("enterprise_admin")),
):
    db = require_db()
    enterprise_id = admin_ctx["enterprise_id"]
    admin_uid = admin_ctx["user"].get("uid")

    try:
        # Verify user belongs to this enterprise
        user_doc = db.client.collection(USERS_COLLECTION).document(user_id).get()

        if (
            not user_doc.exists
            or user_doc.to_dict().get("enterprise_id") != enterprise_id
        ):
            raise HTTPException(
                status_code=404,
                detail="User not found in this enterprise",
            )

        if user_doc.to_dict().get("role") == "stumpmic_admin":
            raise HTTPException(
                status_code=400,
                detail="Platform administrators cannot be assigned integrations from the enterprise console",
            )

        # Integration must be globally available
        integration_doc = (
            db.client.collection(INTEGRATIONS_COLLECTION)
            .document(data.integration_id)
            .get()
        )
        if not integration_doc.exists:
            raise HTTPException(
                status_code=404, detail="Integration not found in catalog"
            )

        integration_catalog = integration_doc.to_dict()
        if not integration_catalog.get("is_active") or not integration_catalog.get(
            "is_visible"
        ):
            raise HTTPException(
                status_code=400,
                detail="This integration is not available",
            )

        # Integration must be actively assigned to this enterprise
        try:
            enterprise_assignment = list(
                db.client.collection(ENT_ASSIGNED_COLLECTION)
                .where("enterprise_id", "==", enterprise_id)
                .where("integration_id", "==", data.integration_id)
                .where("is_active", "==", True)
                .limit(1)
                .stream()
            )
        except Exception as e:
            logger.error(f"Failed to query enterprise assignment: {e}")
            raise HTTPException(
                status_code=500, detail="Database error occurred"
            ) from e
        if not enterprise_assignment:
            raise HTTPException(
                status_code=403,
                detail="Integration is not assigned to this enterprise",
            )

        # Check if integration already assigned to this user
        existing = list(
            db.client.collection(USER_ASSIGNED_COLLECTION)
            .where("enterprise_id", "==", enterprise_id)
            .where("user_id", "==", user_id)
            .where("integration_id", "==", data.integration_id)
            .limit(1)
            .stream()
        )

        if existing:
            raise HTTPException(
                status_code=400,
                detail="Integration already assigned to this user",
            )

        now = datetime.now(timezone.utc)

        integration_data = {
            "enterprise_id": enterprise_id,
            "user_id": user_id,
            "product_id": data.product_id,
            "integration_id": data.integration_id,
            "access_level": data.access_level,
            "is_active": True,
            "assigned_by": admin_uid,
            "assigned_at": now,
            "created_at": now,
            "updated_at": now,
        }

        doc_ref = db.client.collection(USER_ASSIGNED_COLLECTION).document()
        doc_ref.set(integration_data)

        logger.info(
            f"Integration {data.integration_id} assigned to user {user_id} "
            f"in enterprise {enterprise_id} by admin {admin_uid}"
        )

        return response.ApiResponse(
            success=True,
            message="Integration assigned to user successfully",
            data={"assignment_id": doc_ref.id, **integration_data},
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error assigning integration to user {user_id}: {e}")
        raise HTTPException(status_code=500, detail="Failed to assign integration")


@router.patch(
    "/{user_id}/products",
    response_model=response.ApiResponse,
    summary="Update products assigned to a user in the enterprise",
)
async def update_user_products(
    user_id: str,
    data: UpdateUserProductsRequest,
    admin_ctx: dict = Depends(require_enterprise_context("enterprise_admin")),
):
    db = require_db()
    admin_uid = admin_ctx["user"].get("uid", "")
    enterprise_id = admin_ctx["enterprise_id"]

    doc_ref = db.client.collection(USERS_COLLECTION).document(user_id)
    doc = doc_ref.get()

    if not doc.exists or doc.to_dict().get("enterprise_id") != enterprise_id:
        raise HTTPException(status_code=404, detail="User not found in this enterprise")

    if doc.to_dict().get("role") == "stumpmic_admin":
        raise HTTPException(
            status_code=400,
            detail="Platform administrators cannot be assigned products from the enterprise console",
        )

    # Validate all requested product_ids are actively assigned to this enterprise
    if data.product_ids:
        valid_product_ids = {
            d.to_dict().get("product_id")
            for d in db.client.collection(ENTERPRISE_PRODUCTS_COLLECTION)
            .where("enterprise_id", "==", enterprise_id)
            .where("is_active", "==", True)
            .stream()
            if d.to_dict().get("product_id")
        }
        invalid_ids = [pid for pid in data.product_ids if pid not in valid_product_ids]
        if invalid_ids:
            raise HTTPException(
                status_code=400,
                detail=f"Products not assigned to this enterprise: {invalid_ids}",
            )

    try:
        now = datetime.now(timezone.utc)

        # Fetch existing user_products to delete
        existing = list(
            db.client.collection(USER_PRODUCTS_COLLECTION)
            .where("user_id", "==", user_id)
            .where("enterprise_id", "==", enterprise_id)
            .stream()
        )

        # Use a batch write so deletes + creates are atomic
        batch = db.client.batch()

        for up in existing:
            batch.delete(up.reference)

        for product_id in data.product_ids:
            new_ref = db.client.collection(USER_PRODUCTS_COLLECTION).document()
            batch.set(
                new_ref,
                {
                    "user_id": user_id,
                    "product_id": product_id,
                    "enterprise_id": enterprise_id,
                    "is_active": True,
                    "assigned_at": now,
                    "assigned_by": admin_uid,
                    "created_at": now,
                    "updated_at": now,
                },
            )

        batch.commit()

        logger.info(
            f"Products updated for user {doc.to_dict().get('email')} in enterprise {enterprise_id}"
        )

        user_dict = serialize_doc(doc)
        user_dict["product_ids"] = list(data.product_ids)

        return response.ApiResponse(
            success=True,
            message="User products updated successfully",
            data=response.UserData(**user_dict),
        )

    except Exception as e:
        logger.error(f"Error updating products for user {user_id}: {e}")
        raise HTTPException(status_code=500, detail="Failed to update user products")


