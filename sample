def _build_user_product_map(db, enterprise_id: str) -> dict:
    """Return {user_id: [product_id, ...]} for all users in the enterprise."""
    docs = list(
        db.client.collection(USER_PRODUCTS_COLLECTION)
        .where("enterprise_id", "==", enterprise_id)
        .stream()
    )
    result: dict = {}
    for doc in docs:
        d = doc.to_dict()
        uid = d.get("user_id")
        pid = d.get("product_id")
        if uid and pid:
            result.setdefault(uid, []).append(pid)
    return result


def _get_user_product_ids(db, user_id: str, enterprise_id: str) -> List[str]:
    """Return list of product_ids assigned to a single user."""
    docs = list(
        db.client.collection(USER_PRODUCTS_COLLECTION)
        .where("user_id", "==", user_id)
        .where("enterprise_id", "==", enterprise_id)
        .stream()
    )
    return [
        d.to_dict().get("product_id") for d in docs if d.to_dict().get("product_id")
    ]


@router.get(
    "/search",
    response_model=response.ApiListResponse,
    summary="Search users by domain for adding to the enterprise",
)
async def search_users(
    q: str = "",
    page: int = 1,
    page_size: int = 20,
    admin_ctx: dict = Depends(require_enterprise_context("enterprise_admin")),
):
    db = require_db()
    enterprise_domain = admin_ctx.get("enterprise_domain", "")

    if not enterprise_domain:
        return response.ApiListResponse(
            success=True,
            message="No enterprise domain configured",
            data=[],
        )

    try:
        domain = enterprise_domain.lower()
        # Use indexed query on precomputed email_domain + enterprise_id instead of full scan
        candidates = list(
            db.client.collection(USERS_COLLECTION)
            .where("email_domain", "==", domain)
            .where("enterprise_id", "==", None)
            .limit(1000)
            .stream()
        )
        )

    except Exception as e:
        logger.error(f"Error updating products for user {user_id}: {e}")
        raise HTTPException(status_code=500, detail="Failed to update user products")
